const CONFIG = {
  ADMIN_REGISTRATION_KEY: PropertiesService.getScriptProperties().getProperty('ADMIN_REGISTRATION_KEY') || 'Ars@2008',
  EVENTS_FOLDER_ID: PropertiesService.getScriptProperties().getProperty('EVENTS_FOLDER_ID') || '',
  PROFILE_PHOTOS_FOLDER_ID: PropertiesService.getScriptProperties().getProperty('PROFILE_PHOTOS_FOLDER_ID') || '',
  GOOGLE_CLIENT_ID: PropertiesService.getScriptProperties().getProperty('GOOGLE_CLIENT_ID') || 'YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com'
};

const SHEETS = { USERS: 'Users', COMPLAINTS: 'Complaints', EVENTS: 'Events' };
const HEADERS = {
  Users: ['id','role','name','email','passwordHash','phone','department','year','rollNo','employeeId','settings','createdAt','updatedAt','status','profilePhotoUrl','profilePhotoFileId'],
  Complaints: ['id','studentId','studentName','title','category','description','location','priority','status','history','createdAt','updatedAt'],
  Events: ['id','title','description','date','time','location','category','posterUrl','posterFileId','status','createdBy','createdAt','updatedAt']
};

function doGet() { return HtmlService.createHtmlOutputFromFile('index').setTitle('REC CampusConnect').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL); }
function doPost(e) { try { return json_(dispatch_(JSON.parse(e.postData.contents || '{}'))); } catch (err) { return json_({ok:false,message:err.message || 'Invalid request'}); } }
function registerStudent(data){return dispatch_({action:'registerStudent',...data})} function registerAdmin(data){return dispatch_({action:'registerAdmin',...data})}
function login(data){return dispatch_({action:'login',...data})} function googleLogin(data){return dispatch_({action:'googleLogin',...data})}
function dashboard(data){return dispatch_({action:'dashboard',...data})} function listComplaints(data){return dispatch_({action:'listComplaints',...data})}
function createComplaint(data){return dispatch_({action:'createComplaint',...data})} function getComplaint(data){return dispatch_({action:'getComplaint',...data})}
function updateComplaint(data){return dispatch_({action:'updateComplaint',...data})} function listEvents(data){return dispatch_({action:'listEvents',...data})}
function createEvent(data){return dispatch_({action:'createEvent',...data})} function updateEvent(data){return dispatch_({action:'updateEvent',...data})}
function deleteEvent(data){return dispatch_({action:'deleteEvent',...data})} function updateProfile(data){return dispatch_({action:'updateProfile',...data})}
function updateSettings(data){return dispatch_({action:'updateSettings',...data})} function changePassword(data){return dispatch_({action:'changePassword',...data})}
function logout(data){return dispatch_({action:'logout',...data})}

function setupPortal() {
  ensureSheets_();
  PropertiesService.getScriptProperties().setProperty('ADMIN_REGISTRATION_KEY','Ars@2008');
  return 'REC CampusConnect sheets created/updated. Admin registration key configured.';
}

function dispatch_(req) {
  ensureSheets_(); const action=String(req.action||'').trim();
  switch(action){case'registerStudent':return registerStudent_(req);case'registerAdmin':return registerAdmin_(req);case'login':return login_(req);case'googleLogin':return googleLogin_(req);case'dashboard':return dashboard_(req);case'listComplaints':return listComplaints_(req);case'createComplaint':return createComplaint_(req);case'getComplaint':return getComplaint_(req);case'updateComplaint':return updateComplaint_(req);case'listEvents':return listEvents_(req);case'createEvent':return createEvent_(req);case'updateEvent':return updateEvent_(req);case'deleteEvent':return deleteEvent_(req);case'updateProfile':return updateProfile_(req);case'updateSettings':return updateSettings_(req);case'changePassword':return changePassword_(req);case'logout':return logout_(req);default:throw new Error('Unknown API action.')}
}

function assertCollegeEmail_(email,role){
  const normalized=normalizeEmail_(email);
  if(role==='admin'){
    if(normalized!=='admin1@rajalakshmi.edu.in')throw new Error('Admin access is restricted to admin1@rajalakshmi.edu.in.');
    return normalized;
  }
  if(role==='student'){
    if(!/^[^\\s@]+@rajalakshmi\\.edu\\.in$/.test(normalized))throw new Error('Use your college email address ending in @rajalakshmi.edu.in.');
    return normalized;
  }
  throw new Error('Invalid portal type.');
}
function registerStudent_(r){validate_(r.name,'Full name');validate_(r.email,'Email');assertCollegeEmail_(r.email,'student');validate_(r.password,'Password');validate_(r.rollNo,'Roll / Register No.');validate_(r.department,'Department');if(String(r.password).length<6)throw new Error('Password must be at least 6 characters.');if(findUserByEmail_(r.email))throw new Error('An account already exists with this email.');if(findUserByRoll_(r.rollNo))throw new Error('This roll / register number is already registered.');const now=new Date().toISOString();const user={id:id_('STU'),role:'student',name:String(r.name).trim(),email:normalizeEmail_(r.email),passwordHash:hash_(r.password),phone:String(r.phone||'').trim(),department:String(r.department||'').trim(),year:String(r.year||''),rollNo:String(r.rollNo||'').trim(),employeeId:'',settings:JSON.stringify(defaultSettings_()),createdAt:now,updatedAt:now,status:'active',profilePhotoUrl:'',profilePhotoFileId:''};appendObject_(SHEETS.USERS,user);return{ok:true,user:safeUser_(user)}}
function registerAdmin_(r){if(String(r.adminKey||'')!==CONFIG.ADMIN_REGISTRATION_KEY)throw new Error('Invalid admin registration password.');validate_(r.name,'Full name');validate_(r.email,'Email');assertCollegeEmail_(r.email,'admin');validate_(r.password,'Password');if(String(r.password).length<6)throw new Error('Password must be at least 6 characters.');if(findUserByEmail_(r.email))throw new Error('An account already exists with this email.');const now=new Date().toISOString();const user={id:id_('ADM'),role:'admin',name:String(r.name).trim(),email:normalizeEmail_(r.email),passwordHash:hash_(r.password),phone:String(r.phone||'').trim(),department:String(r.department||'Administration').trim(),year:'',rollNo:'',employeeId:'',settings:JSON.stringify(defaultSettings_()),createdAt:now,updatedAt:now,status:'active',profilePhotoUrl:'',profilePhotoFileId:''};appendObject_(SHEETS.USERS,user);return{ok:true,user:safeUser_(user)}}
function login_(r){const role=String(r.role||'student');assertCollegeEmail_(r.email,role);const user=findUserByEmail_(r.email);if(!user||user.role!==String(r.role||'student'))throw new Error('Invalid email, password or portal type.');if(user.status!=='active')throw new Error('This account is inactive.');if(!user.passwordHash||hash_(r.password)!==user.passwordHash)throw new Error('Invalid email or password.');return sessionResponse_(user)}

function googleLogin_(r){if(String(r.role||'student')!=='student')throw new Error('Google sign-in is available for students only.');const profile=verifyGoogleCredential_(r.credential);assertCollegeEmail_(profile.email,'student');let user=findUserByGoogleSub_(profile.sub)||findUserByEmail_(profile.email);const now=new Date().toISOString();if(user){if(user.role!=='student')throw new Error('This Google account is linked to an administrator account. Use Admin Login.');const settings={...defaultSettings_(),...parseJson_(user.settings,{})};settings.googleSub=profile.sub;settings.authProvider='google';if(!user.name||user.name==='Google Student')user.name=profile.name||user.name;user.settings=JSON.stringify(settings);user.updatedAt=now;updateObject_(SHEETS.USERS,user.id,user)}else{user={id:id_('STU'),role:'student',name:profile.name||'Google Student',email:profile.email,passwordHash:'',phone:'',department:'',year:'',rollNo:'',employeeId:'',settings:JSON.stringify({...defaultSettings_(),googleSub:profile.sub,authProvider:'google'}),createdAt:now,updatedAt:now,status:'active',profilePhotoUrl:'',profilePhotoFileId:''};appendObject_(SHEETS.USERS,user)}return sessionResponse_(user)}
function verifyGoogleCredential_(credential){validate_(credential,'Google credential');if(!CONFIG.GOOGLE_CLIENT_ID||CONFIG.GOOGLE_CLIENT_ID.indexOf('YOUR_GOOGLE_CLIENT_ID')===0)throw new Error('Google sign-in is not configured. Set GOOGLE_CLIENT_ID in Apps Script Properties.');const url='https://oauth2.googleapis.com/tokeninfo?id_token='+encodeURIComponent(String(credential));const response=UrlFetchApp.fetch(url,{muteHttpExceptions:true});const code=response.getResponseCode();if(code<200||code>=300)throw new Error('Google credential could not be verified.');const token=parseJson_(response.getContentText(),{});if(token.aud!==CONFIG.GOOGLE_CLIENT_ID)throw new Error('This Google sign-in client is not configured for REC CampusConnect.');if(token.email_verified!=='true')throw new Error('Your Google email must be verified.');if(!token.sub||!token.email)throw new Error('Google did not return a valid account.');return{sub:String(token.sub),email:normalizeEmail_(token.email),name:String(token.name||'Google Student')}}
function sessionResponse_(user){const token=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().replace(/-/g,'');CacheService.getScriptCache().put('sess_'+token,JSON.stringify({userId:user.id,role:user.role}),21600);const latest=findById_(SHEETS.USERS,user.id)||user;const settings=parseJson_(latest.settings,{});settings.lastLoginAt=new Date().toISOString();latest.settings=JSON.stringify(settings);latest.updatedAt=new Date().toISOString();updateObject_(SHEETS.USERS,latest.id,latest);return{ok:true,session:token,user:safeUser_(latest)}}

function dashboard_(r){const user=auth_(r.token);const complaints=complaints_().filter(c=>user.role==='admin'||c.studentId===user.id);const published=events_().filter(e=>String(e.status).toLowerCase()==='published');const upcoming=published.filter(isUpcomingEvent_).sort((a,b)=>eventTimestamp_(a)-eventTimestamp_(b));const past=published.filter(e=>!isUpcomingEvent_(e)).sort((a,b)=>eventTimestamp_(b)-eventTimestamp_(a));const stats={total:complaints.length,open:complaints.filter(c=>c.status==='open').length,inProgress:complaints.filter(c=>c.status==='inprogress').length,resolved:complaints.filter(c=>c.status==='resolved').length,events:upcoming.length};return{ok:true,user:safeUser_(user),stats,recentComplaints:complaints.sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt)).slice(0,5),upcomingEvents:upcoming.slice(0,8),recentEvents:past.slice(0,5),upcomingOnly:upcoming.slice(0,5)}}
function listComplaints_(r){const user=auth_(r.token);let list=complaints_();if(user.role!=='admin')list=list.filter(c=>c.studentId===user.id);if(r.status&&r.status!=='all')list=list.filter(c=>c.status===r.status);list.sort((a,b)=>new Date(b.createdAt)-new Date(a.createdAt));return{ok:true,complaints:list}}
function createComplaint_(r){const user=auth_(r.token,'student');const d=r.complaint||{};validate_(d.title,'Complaint title');validate_(d.description,'Description');const now=new Date().toISOString();const id=id_('CMP');const history=[{type:'system',action:'Complaint submitted',note:'Complaint received by REC CampusConnect.',at:now,by:user.name}];const c={id,studentId:user.id,studentName:user.name,title:String(d.title).trim(),category:String(d.category||'Other'),description:String(d.description).trim(),location:String(d.location||'').trim(),priority:String(d.priority||'Medium'),status:'open',history:JSON.stringify(history),createdAt:now,updatedAt:now};appendObject_(SHEETS.COMPLAINTS,c);return{ok:true,complaint:publicComplaint_(c)}}

function getComplaint_(r){const user=auth_(r.token);let c=findById_(SHEETS.COMPLAINTS,r.id);if(!c)throw new Error('Complaint not found.');if(user.role!=='admin'&&c.studentId!==user.id)throw new Error('You are not allowed to view this complaint.');if(user.role==='admin')c=recordAdminView_(c,user);return{ok:true,complaint:publicComplaint_(c)}}
function recordAdminView_(c,admin){const history=parseJson_(c.history,[]);const last=history.filter(h=>h.type==='admin_view').slice(-1)[0];if(!last||last.adminId!==admin.id||(Date.now()-new Date(last.at).getTime())>60000){const now=new Date().toISOString();history.push({type:'admin_view',action:'Viewed by administrator',note:'An administrator opened this complaint.',at:now,by:admin.name,adminId:admin.id,adminName:admin.name,adminEmail:admin.email,adminPhone:admin.phone||''});c.history=JSON.stringify(history);c.updatedAt=now;updateObject_(SHEETS.COMPLAINTS,c.id,c)}return c}
function updateComplaint_(r){const user=auth_(r.token,'admin');let c=findById_(SHEETS.COMPLAINTS,r.id);if(!c)throw new Error('Complaint not found.');c=recordAdminView_(c,user);const status=['open','inprogress','resolved'].includes(String(r.status))?String(r.status):c.status;const note=String(r.note||'').trim();const history=parseJson_(c.history,[]);const now=new Date().toISOString();history.push({type:'status',status:status,action:'Status changed to '+statusLabel_(status),note:note||'No additional note.',at:now,by:user.name,adminId:user.id,adminName:user.name,adminEmail:user.email,adminPhone:user.phone||''});c.status=status;c.history=JSON.stringify(history);c.updatedAt=now;updateObject_(SHEETS.COMPLAINTS,c.id,c);return{ok:true,complaint:publicComplaint_(c)}}

function listEvents_(r){const user=auth_(r.token);let list=events_();if(user.role!=='admin')list=list.filter(e=>e.status==='published');return{ok:true,events:eventBoard_(list)}}
function eventBoard_(list){return list.slice().sort((a,b)=>{const af=isUpcomingEvent_(a),bf=isUpcomingEvent_(b);if(af!==bf)return af?-1:1;return af?eventTimestamp_(a)-eventTimestamp_(b):eventTimestamp_(b)-eventTimestamp_(a)})}
function eventTimestamp_(e){const d=eventDate_(e);return d?d.getTime():0}
function eventDate_(e){const raw=e&&e.date;if(!raw)return null;if(raw instanceof Date&&!isNaN(raw))return new Date(raw.getFullYear(),raw.getMonth(),raw.getDate());const s=String(raw).trim();let m=s.match(/^(\d{4})-(\d{2})-(\d{2})/);if(m)return new Date(Number(m[1]),Number(m[2])-1,Number(m[3]));m=s.match(/^(\d{1,2})[\/-](\d{1,2})[\/-](\d{4})/);if(m)return new Date(Number(m[3]),Number(m[2])-1,Number(m[1]));const d=new Date(s);return isNaN(d)?null:new Date(d.getFullYear(),d.getMonth(),d.getDate())}
function isUpcomingEvent_(e){const d=eventDate_(e);if(!d)return false;const today=new Date();const t=new Date(today.getFullYear(),today.getMonth(),today.getDate());return d.getTime()>=t.getTime()}
function createEvent_(r){const user=auth_(r.token,'admin'),d=r.event||{};validate_(d.title,'Event title');validate_(d.description,'Description');validate_(d.date,'Event date');const now=new Date().toISOString();let poster={url:'',id:''};if(d.poster&&d.poster.data)poster=savePoster_(d.poster);const e={id:id_('EVT'),title:String(d.title).trim(),description:String(d.description).trim(),date:String(d.date),time:String(d.time||'').trim(),location:String(d.location||'').trim(),category:String(d.category||'General'),posterUrl:poster.url,posterFileId:poster.id,status:String(d.status||'draft')==='published'?'published':'draft',createdBy:user.id,createdAt:now,updatedAt:now};appendObject_(SHEETS.EVENTS,e);return{ok:true,event:e}}
function updateEvent_(r){auth_(r.token,'admin');const d=r.event||{},e=findById_(SHEETS.EVENTS,d.id);if(!e)throw new Error('Event not found.');['title','description','date','time','location','category','status'].forEach(k=>{if(d[k]!==undefined&&d[k]!=='')e[k]=String(d[k])});if(d.poster&&d.poster.data){const poster=savePoster_(d.poster);e.posterUrl=poster.url;e.posterFileId=poster.id}e.updatedAt=new Date().toISOString();updateObject_(SHEETS.EVENTS,e.id,e);return{ok:true,event:e}}
function deleteEvent_(r){auth_(r.token,'admin');const e=findById_(SHEETS.EVENTS,r.id);if(!e)throw new Error('Event not found.');const sh=SpreadsheetApp.getActive().getSheetByName(SHEETS.EVENTS),row=findRow_(sh,'id',e.id);if(row>1)sh.deleteRow(row);if(e.posterFileId){try{DriveApp.getFileById(e.posterFileId).setTrashed(true)}catch(err){}}return{ok:true}}

function updateProfile_(r){const user=auth_(r.token),p=r.profile||{},row=findById_(SHEETS.USERS,user.id);row.name=String(p.name||row.name).trim();row.phone=String(p.phone||'').trim();row.department=String(p.department||'').trim();if(user.role==='student'){row.rollNo=String(p.identifier||row.rollNo).trim();row.year=String(p.year||row.year)}else row.employeeId=String(p.identifier||row.employeeId).trim();if(p.profilePhoto&&p.profilePhoto.data){const photo=saveProfilePhoto_(p.profilePhoto,user.id);row.profilePhotoUrl=photo.url;row.profilePhotoFileId=photo.id}row.updatedAt=new Date().toISOString();updateObject_(SHEETS.USERS,row.id,row);return{ok:true,user:safeUser_(row)}}
function updateSettings_(r){const user=auth_(r.token),row=findById_(SHEETS.USERS,user.id),settings={...defaultSettings_(),...parseJson_(row.settings,{}),...(r.settings||{})};row.settings=JSON.stringify(settings);row.updatedAt=new Date().toISOString();updateObject_(SHEETS.USERS,row.id,row);return{ok:true,settings}}
function changePassword_(r){const user=auth_(r.token),row=findById_(SHEETS.USERS,user.id);if(!row.passwordHash||hash_(r.currentPassword)!==row.passwordHash)throw new Error('Current password is incorrect.');if(String(r.newPassword||'').length<6)throw new Error('New password must be at least 6 characters.');row.passwordHash=hash_(r.newPassword);row.updatedAt=new Date().toISOString();updateObject_(SHEETS.USERS,row.id,row);CacheService.getScriptCache().remove('sess_'+r.token);return{ok:true}}
function logout_(r){if(r.token)CacheService.getScriptCache().remove('sess_'+r.token);return{ok:true}}
function auth_(token,role){if(!token)throw new Error('Session expired. Please log in again.');const raw=CacheService.getScriptCache().get('sess_'+token);if(!raw)throw new Error('Session expired. Please log in again.');const s=JSON.parse(raw);if(role&&s.role!==role)throw new Error('You do not have permission for this action.');const user=findById_(SHEETS.USERS,s.userId);if(!user)throw new Error('Account not found.');if(user.status!=='active')throw new Error('Account is inactive.');return user}

function savePoster_(poster){if(!poster.data)return{url:'',id:''};const folder=getEventsFolder_(),bytes=Utilities.base64Decode(poster.data),blob=Utilities.newBlob(bytes,poster.type||MimeType.JPEG,poster.name||('poster_'+Date.now()+'.jpg')),file=folder.createFile(blob);try{file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW)}catch(err){}return{url:'https://drive.google.com/uc?export=view&id='+file.getId(),id:file.getId()}}
function getEventsFolder_(){if(CONFIG.EVENTS_FOLDER_ID){try{return DriveApp.getFolderById(CONFIG.EVENTS_FOLDER_ID)}catch(err){}}const folders=DriveApp.getFoldersByName('REC CampusConnect Event Posters'),folder=folders.hasNext()?folders.next():DriveApp.createFolder('REC CampusConnect Event Posters');PropertiesService.getScriptProperties().setProperty('EVENTS_FOLDER_ID',folder.getId());return folder}
function saveProfilePhoto_(photo,userId){const folder=getProfilePhotosFolder_(),bytes=Utilities.base64Decode(photo.data),safeName=String(photo.name||'profile.jpg').replace(/[^a-zA-Z0-9._-]/g,'_'),blob=Utilities.newBlob(bytes,photo.type||MimeType.JPEG,'profile_'+userId+'_'+Date.now()+'_'+safeName),file=folder.createFile(blob);try{file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW)}catch(err){}return{url:'https://drive.google.com/uc?export=view&id='+file.getId(),id:file.getId()}}
function getProfilePhotosFolder_(){if(CONFIG.PROFILE_PHOTOS_FOLDER_ID){try{return DriveApp.getFolderById(CONFIG.PROFILE_PHOTOS_FOLDER_ID)}catch(err){}}const folders=DriveApp.getFoldersByName('REC CampusConnect Profile Photos'),folder=folders.hasNext()?folders.next():DriveApp.createFolder('REC CampusConnect Profile Photos');PropertiesService.getScriptProperties().setProperty('PROFILE_PHOTOS_FOLDER_ID',folder.getId());return folder}
function ensureSheets_(){const ss=SpreadsheetApp.getActiveSpreadsheet();Object.keys(HEADERS).forEach(name=>{let sh=ss.getSheetByName(name);if(!sh)sh=ss.insertSheet(name);const h=HEADERS[name];if(sh.getLastRow()===0){sh.getRange(1,1,1,h.length).setValues([h]);sh.setFrozenRows(1);return}const existing=sh.getRange(1,1,1,Math.max(sh.getLastColumn(),h.length)).getValues()[0];h.forEach((key,i)=>{if(String(existing[i]||'').trim()!==key)sh.getRange(1,i+1).setValue(key)});sh.setFrozenRows(1)})}
function sheetObjects_(name){const sh=SpreadsheetApp.getActive().getSheetByName(name),h=HEADERS[name];if(!sh||sh.getLastRow()<2)return[];const vals=sh.getRange(2,1,sh.getLastRow()-1,h.length).getValues();return vals.filter(row=>row.some(v=>v!=='')).map(row=>{const o={};h.forEach((k,i)=>{const v=row[i];o[k]=v instanceof Date?v.toISOString():v});return o})}
function users_(){return sheetObjects_(SHEETS.USERS)} function complaints_(){return sheetObjects_(SHEETS.COMPLAINTS).map(publicComplaint_)} function events_(){return sheetObjects_(SHEETS.EVENTS)}
function findUserByEmail_(email){const x=normalizeEmail_(email);return users_().find(u=>u.email===x)}
function findUserByGoogleSub_(sub){return users_().find(u=>parseJson_(u.settings,{}).googleSub===String(sub))}
function findUserByRoll_(roll){const x=String(roll||'').trim().toLowerCase();return users_().find(u=>String(u.rollNo||'').trim().toLowerCase()===x)}
function findById_(sheetName,id){return sheetObjects_(sheetName).find(o=>String(o.id)===String(id))}
function findRow_(sh,key,value){const idx=HEADERS[sh.getName()].indexOf(key)+1;if(idx<1)return-1;const count=Math.max(sh.getLastRow()-1,0);if(!count)return-1;const vals=sh.getRange(2,idx,count,1).getValues();for(let i=0;i<vals.length;i++)if(String(vals[i][0])===String(value))return i+2;return-1}
function appendObject_(sheetName,obj){const lock=LockService.getScriptLock();lock.waitLock(10000);try{const sh=SpreadsheetApp.getActive().getSheetByName(sheetName),h=HEADERS[sheetName];sh.appendRow(h.map(k=>obj[k]??''))}finally{lock.releaseLock()}}
function updateObject_(sheetName,id,obj){const sh=SpreadsheetApp.getActive().getSheetByName(sheetName),h=HEADERS[sheetName],row=findRow_(sh,'id',id);if(row<2)throw new Error('Record not found.');sh.getRange(row,1,1,h.length).setValues([h.map(k=>obj[k]??'')])}

function publicComplaint_(c){if(!c)return c;const history=parseJson_(c.history,[]),statusHistory=history.filter(h=>h.type==='status'),sameStatus=statusHistory.filter(h=>!h.status||h.status===c.status),statusUpdate=sameStatus.slice(-1)[0]||statusHistory.slice(-1)[0],view=history.filter(h=>h.type==='admin_view').slice(-1)[0],contact=statusUpdate||view,out={...c,history};if(contact)out.adminContact={id:contact.adminId||'',name:contact.adminName||contact.by||'Administrator',email:contact.adminEmail||'',phone:contact.adminPhone||'',seenAt:contact.at,action:contact.action||'Viewed by administrator',status:contact.status||c.status};else delete out.adminContact;return out}
function safeUser_(u){const settings=parseJson_(u.settings,defaultSettings_());return{id:u.id,role:u.role,name:u.name,email:u.email,phone:u.phone,department:u.department,year:u.year,rollNo:u.rollNo,employeeId:u.employeeId,profilePhotoUrl:u.profilePhotoUrl||'',settings,authProvider:settings.authProvider||'password',status:u.status,createdAt:u.createdAt}}
function defaultSettings_(){return{systemAlerts:true,complaintUpdates:true,eventInvitations:true,directoryVisibility:true}}
function validate_(v,label){if(!String(v||'').trim())throw new Error(label+' is required.')}
function normalizeEmail_(v){return String(v||'').trim().toLowerCase()}
function hash_(value){const bytes=Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,String(value||''),Utilities.Charset.UTF_8);return bytes.map(b=>{const n=b<0?b+256:b;return('0'+n.toString(16)).slice(-2)}).join('')}
function id_(prefix){return prefix+'-'+new Date().getFullYear()+'-'+Utilities.getUuid().slice(0,8).toUpperCase()}
function parseJson_(v,fallback){try{return v?JSON.parse(v):fallback}catch(err){return fallback}}
function statusLabel_(s){return s==='inprogress'?'In Progress':s==='resolved'?'Resolved':'Open'}
function json_(obj){return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON)}
